<Window x:Class="SoundModes.Tray.Toast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Focusable="False" SizeToContent="WidthAndHeight">
    <Border Background="#E6202020" CornerRadius="8" Padding="22,12">
        <TextBlock x:Name="Message" Foreground="White" FontSize="16" FontWeight="SemiBold"
                   FontFamily="Segoe UI Variable Display, Segoe UI" />
    </Border>
</Window>
