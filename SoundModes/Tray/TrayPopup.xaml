<Window x:Class="SoundModes.Tray.TrayPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SoundModes"
        Title="{x:Static local:Strings.AppName}" Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{DynamicResource Fg}">
    <Window.Resources>
        <!-- Theme brushes; replaced at runtime by ApplyTheme() to follow Windows light/dark. -->
        <SolidColorBrush x:Key="Bg" Color="#F9F9F9" />
        <SolidColorBrush x:Key="Fg" Color="#1A1A1A" />
        <SolidColorBrush x:Key="Subtle" Color="#5C5C5C" />
        <SolidColorBrush x:Key="Edge" Color="#E0E0E0" />
        <SolidColorBrush x:Key="ButtonBg" Color="#EDEDED" />
        <SolidColorBrush x:Key="ButtonHover" Color="#E0E0E0" />
        <SolidColorBrush x:Key="Accent" Color="#0067C0" />
        <SolidColorBrush x:Key="Warning" Color="#9D5D00" />

        <ControlTemplate x:Key="FlatButton" TargetType="ButtonBase">
            <Border x:Name="Box" Background="{DynamicResource ButtonBg}" CornerRadius="4"
                    BorderBrush="Transparent" BorderThickness="2" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource ButtonHover}" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Fg}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="Button">
            <Setter Property="Template" Value="{StaticResource FlatButton}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <!-- Wrapped, readable tooltips for the plain-language explanations. -->
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="280" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Label + (i) that shows its tooltip quickly and keeps it up long enough to read. -->
        <Style x:Key="InfoLabel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        </Style>
        <Style x:Key="InfoIcon" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE946;" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="5,1,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Subtle}" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Minimum" Value="-12" />
            <Setter Property="Maximum" Value="12" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="3" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Template" Value="{StaticResource FlatButton}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="GroupName" Value="Modes" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Edge}" BorderThickness="1"
            CornerRadius="8" Padding="16">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="&#x2715;" Padding="8,2" MinHeight="28"
                        ToolTip="{x:Static local:Strings.Close}" AutomationProperties.Name="{x:Static local:Strings.Close}" Click="OnCloseClick" />
                <TextBlock Text="{x:Static local:Strings.AppName}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <UniformGrid x:Name="ModeButtons" Rows="1" Margin="-2,14,-2,0" />

            <StackPanel x:Name="SetupPanel" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock x:Name="SetupText" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="SetupAction" Click="OnSetupActionClick" Margin="0,0,8,0" />
                    <Button Content="{x:Static local:Strings.CheckAgain}" Click="OnCheckAgainClick" />
                </StackPanel>
            </StackPanel>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>

                <TextBlock Text="{x:Static local:Strings.Volume}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="2" LargeChange="10"
                        AutomationProperties.Name="{x:Static local:Strings.Volume}" ValueChanged="OnVolumeSliderChanged" />
                <TextBlock x:Name="VolumeText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />

                <!-- Global loudness boost on top of Windows volume (Equalizer APO preamp); applies to every mode. -->
                <StackPanel Grid.Row="1" Style="{StaticResource InfoLabel}" ToolTip="{x:Static local:Strings.BoostTip}" Margin="0,0,12,0">
                    <TextBlock Text="{x:Static local:Strings.Boost}" />
                    <TextBlock Style="{StaticResource InfoIcon}" />
                </StackPanel>
                <Slider x:Name="BoostSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="12" LargeChange="2"
                        AutomationProperties.Name="{x:Static local:Strings.Boost}"
                        AutomationProperties.HelpText="{x:Static local:Strings.BoostTip}" />
                <TextBlock x:Name="BoostText" Grid.Row="1" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <ToggleButton x:Name="AdvancedToggle" Margin="-4,12,0,0" HorizontalAlignment="Left"
                          Checked="OnAdvancedToggled" Unchecked="OnAdvancedToggled"
                          AutomationProperties.Name="{x:Static local:Strings.Advanced}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Box" Background="Transparent" BorderBrush="Transparent" BorderThickness="2"
                                CornerRadius="4" Padding="4,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource ButtonHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
                <TextBlock x:Name="AdvancedLabel" Foreground="{DynamicResource Subtle}" />
            </ToggleButton>

            <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,6,0,0">
                <TextBlock x:Name="AdvancedTitle" Margin="0,0,0,6" FontSize="12" Foreground="{DynamicResource Subtle}" TextWrapping="Wrap" />
                <Grid x:Name="EqControls">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Hovering the label or its (i) shows a plain-language explanation. Sliders have none (it popped up while dragging); screen readers get it via HelpText. -->
                    <StackPanel Style="{StaticResource InfoLabel}" ToolTip="{x:Static local:Strings.BassTip}">
                        <TextBlock Text="{x:Static local:Strings.Bass}" />
                        <TextBlock Style="{StaticResource InfoIcon}" />
                    </StackPanel>
                    <Slider x:Name="BassSlider" Grid.Column="1"
                            AutomationProperties.Name="{x:Static local:Strings.Bass}"
                            AutomationProperties.HelpText="{x:Static local:Strings.BassTip}" />
                    <TextBlock x:Name="BassText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />

                    <StackPanel Grid.Row="1" Style="{StaticResource InfoLabel}" ToolTip="{x:Static local:Strings.LowMidTip}">
                        <TextBlock Text="{x:Static local:Strings.LowMid}" />
                        <TextBlock Style="{StaticResource InfoIcon}" />
                    </StackPanel>
                    <Slider x:Name="LowMidSlider" Grid.Row="1" Grid.Column="1"
                            AutomationProperties.Name="{x:Static local:Strings.LowMid}"
                            AutomationProperties.HelpText="{x:Static local:Strings.LowMidTip}" />
                    <TextBlock x:Name="LowMidText" Grid.Row="1" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />

                    <StackPanel Grid.Row="2" Style="{StaticResource InfoLabel}" ToolTip="{x:Static local:Strings.VoiceTip}">
                        <TextBlock Text="{x:Static local:Strings.Voice}" />
                        <TextBlock Style="{StaticResource InfoIcon}" />
                    </StackPanel>
                    <Slider x:Name="VoiceSlider" Grid.Row="2" Grid.Column="1"
                            AutomationProperties.Name="{x:Static local:Strings.Voice}"
                            AutomationProperties.HelpText="{x:Static local:Strings.VoiceTip}" />
                    <TextBlock x:Name="VoiceText" Grid.Row="2" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />

                    <StackPanel Grid.Row="3" Style="{StaticResource InfoLabel}" ToolTip="{x:Static local:Strings.TrebleTip}">
                        <TextBlock Text="{x:Static local:Strings.Treble}" />
                        <TextBlock Style="{StaticResource InfoIcon}" />
                    </StackPanel>
                    <Slider x:Name="TrebleSlider" Grid.Row="3" Grid.Column="1"
                            AutomationProperties.Name="{x:Static local:Strings.Treble}"
                            AutomationProperties.HelpText="{x:Static local:Strings.TrebleTip}" />
                    <TextBlock x:Name="TrebleText" Grid.Row="3" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />

                    <CheckBox x:Name="CutRumbleCheck" Grid.Row="4" Grid.ColumnSpan="3" Margin="0,6,0,0"
                              ToolTip="{x:Static local:Strings.CutRumbleTip}" Foreground="{DynamicResource Fg}"
                              ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="30000"
                              AutomationProperties.Name="{x:Static local:Strings.CutRumble}"
                              AutomationProperties.HelpText="{x:Static local:Strings.CutRumbleTip}"
                              Click="OnCutRumbleClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static local:Strings.CutRumble}" />
                            <TextBlock Style="{StaticResource InfoIcon}" />
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Grid.Row="5" Grid.ColumnSpan="3" Margin="0,12,0,4" Text="{x:Static local:Strings.CustomLines}" />
                    <TextBox x:Name="ExtraLinesBox" Grid.Row="6" Grid.ColumnSpan="3" Height="64"
                             AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             MaxLength="4000" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             Background="{DynamicResource ButtonBg}" Foreground="{DynamicResource Fg}"
                             BorderBrush="{DynamicResource Edge}" CaretBrush="{DynamicResource Fg}"
                             ToolTip="{x:Static local:Strings.CustomLinesTip}"
                             AutomationProperties.Name="{x:Static local:Strings.CustomLines}" />

                    <Button Grid.Row="7" Grid.ColumnSpan="3" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Content="{x:Static local:Strings.ApplyLines}" Click="OnApplyLinesClick" />
                </Grid>
            </StackPanel>

            <TextBlock x:Name="HintText" Margin="0,14,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource Subtle}" />
        </StackPanel>
    </Border>
</Window>
